# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and supply the actual configuration values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (Prisma)
# ------------------------------------------------------------------------------
# For local SQLite development (zero-setup demo mode):
DATABASE_URL="file:./dev.db"
# For production PostgreSQL (Neon, Supabase, Railway, or Docker):
# DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/mydb?schema=public"

# ------------------------------------------------------------------------------
# 2. Session Security (JWT / JOSE Signing Secret)
# ------------------------------------------------------------------------------
# Server-only cryptographic key used by jose to sign and verify session JWTs.
# MUST be a long random string (at least 32 characters) in production. Never commit the actual secret!
# Generate with: openssl rand -base64 32
SESSION_SECRET="change_me_to_a_secure_random_string_at_least_32_chars_long"

# ------------------------------------------------------------------------------
# 3. Pusher Real-Time Chat (WebSocket Messaging)
# ------------------------------------------------------------------------------
# Obtain these credentials from your Pusher Channels dashboard -> App Keys (https://dashboard.pusher.com)
PUSHER_APP_ID="your_pusher_app_id"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_public_key"
PUSHER_SECRET="your_pusher_secret"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# ------------------------------------------------------------------------------
# 4. Cloudinary (Avatar Image Uploads)
# ------------------------------------------------------------------------------
# Obtain these from your Cloudinary Console dashboard (https://console.cloudinary.com)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
